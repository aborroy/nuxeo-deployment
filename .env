# Public Nuxeo source defaults.
# Checked on 2026-05-26 against the public nuxeo/nuxeo branch "2025".
NUXEO_GIT_TRACK=2025
NUXEO_GIT_REF=9531f6bcb93a82f7c252c5d3bce52104d41a4857
NUXEO_SOURCE_ARCHIVE_URL=https://github.com/nuxeo/nuxeo/archive/9531f6bcb93a82f7c252c5d3bce52104d41a4857.tar.gz
NUXEO_BUILD_THREADS=6

# Nuxeo Web UI — built from public nuxeo/nuxeo-web-ui source (lts-2025 branch).
