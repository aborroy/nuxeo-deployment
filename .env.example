# Public Nuxeo source defaults.
# Checked on 2026-08-26 against the public nuxeo/nuxeo branch "2025" (HEAD = 2025.20-SNAPSHOT).
# The public 2025 LTS server has no release tags/artifacts (released nuxeo-parent is behind Nuxeo
# Connect), so this is inherently a SNAPSHOT build; the Dockerfile builds nuxeo-parent from source
# and patches the web-ui parent to it.
NUXEO_GIT_TRACK=2025
NUXEO_GIT_REF=bf565575542bc0a77485dcbc51f691b243efbb01
NUXEO_SOURCE_ARCHIVE_URL=https://github.com/nuxeo/nuxeo/archive/bf565575542bc0a77485dcbc51f691b243efbb01.tar.gz
NUXEO_BUILD_THREADS=6

# Nuxeo Web UI — built from public nuxeo/nuxeo-web-ui source (lts-2025 branch).
# Checked on 2026-08-26: pinned to release tag v2025.18.0 (latest release on lts-2025).
NUXEO_WEBUI_GIT_REF=0527b4c75cf3ee60183122b956b74f9a4a1159a5
NUXEO_WEBUI_VERSION=2025.18.0

NUXEO_IMAGE_NAME=nuxeo-deployment:nuxeo-local
NUXEO_PLATFORM=linux/amd64

NUXEO_HTTP_PORT=8081
NUXEO_URL=http://localhost:8081/nuxeo
NUXEO_API_URL=http://localhost:8081/nuxeo/api/v1
NUXEO_USERNAME=Administrator
NUXEO_PASSWORD=Administrator

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=nuxeo
POSTGRES_USER=nuxeo
POSTGRES_PASSWORD=nuxeo

NUXEO_PACKAGES=
NUXEO_DEV=true
